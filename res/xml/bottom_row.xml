<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung-style bottom row -->
<row height="0.90">
  <!-- !#1: switch to symbols -->
  <key width="1.2" role="action" key0="switch_numeric" key1="loc switch_greekmath" key4="loc switch_emoji"/>
  <!-- Globe: change method -->
  <key width="1.0" role="action" key0="loc change_method" key1="loc switch_clipboard" key2="config"/>
  <!-- Comma -->
  <key width="1.0" role="action" key0=","/>
  <!-- Space bar with cursor slider -->
  <key width="5.2" role="space_bar" key0="space" key5="cursor_left" key6="cursor_right" key7="page_up" key8="page_down"/>
  <!-- Period -->
  <key width="1.0" role="action" key0="."/>
  <!-- Enter -->
  <key width="1.2" role="action" key0="enter" key1="loc voice_typing" key2="action"/>
</row>
