<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung-style toolbar: 6 icons, themed with keyboard background -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/keyboard_toolbar"
  android:layout_width="match_parent"
  android:layout_height="40dp"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:paddingHorizontal="4dp"
  android:background="?attr/colorKeyboard">

  <!-- 1. Cursor move -->
  <ImageView
    android:id="@+id/tb_cursor"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_toolbar_cursor"
    android:background="@android:color/transparent"/>

  <!-- 2. Text select -->
  <ImageView
    android:id="@+id/tb_select"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_toolbar_select"
    android:background="@android:color/transparent"/>

  <!-- 3. Clipboard -->
  <ImageView
    android:id="@+id/tb_clipboard"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_toolbar_clipboard"
    android:background="@android:color/transparent"/>

  <!-- 4. Translate -->
  <ImageView
    android:id="@+id/tb_translate"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_toolbar_translate"
    android:background="@android:color/transparent"/>

  <!-- 5. Keyboard switch -->
  <ImageView
    android:id="@+id/tb_keyboard"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_toolbar_keyboard"
    android:background="@android:color/transparent"/>

  <!-- 6. More (vertical dots) -->
  <ImageView
    android:id="@+id/tb_more"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_toolbar_more"
    android:background="@android:color/transparent"/>

</LinearLayout>
